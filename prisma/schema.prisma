generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Utilisateurs (patients, médecins, admin)
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  role           Role      @default(PATIENT)
  phone          String?
  gender         Gender?
  country        String?
  city           String?
  specialty      String?   @map("specialty")
  hospital       String?
  medicalLicense String?   @map("medical_license")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  appointments   Appointment[] @relation("PatientAppointments")
  doctorAppointments Appointment[] @relation("DoctorAppointments")
  payments       Payment[]
  sentMessages   Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  formationRegistrations FormationRegistration[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([role])
  @@map("users")
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum Gender {
  MALE
  FEMALE
}

// Rendez-vous
model Appointment {
  id          String          @id @default(cuid())
  doctorId    String          @map("doctor_id")
  patientId   String          @map("patient_id")
  doctor      User            @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  patient     User            @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  
  date        DateTime        @map("date")
  time        String
  status      AppointmentStatus @default(PENDING)
  notes       String?
  videoLink   String?         @map("video_link")
  videoPlatform String?        @map("video_platform") // GOOGLE_MEET, ZOOM, Jitsi, etc.
  videoStatus String?         @map("video_status") // PENDING, ACTIVE, ENDED
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  payment     Payment?

  @@index([doctorId, date])
  @@index([patientId, date])
  @@map("appointments")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

// Paiements
model Payment {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(CASH)
  status        PaymentStatus @default(PENDING)
  reference     String        @unique
  providerRef   String?       @map("provider_ref")
  
  appointmentId String?       @unique @map("appointment_id")
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("payments")
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  ORANGE_MONEY
  MOBILE_MONEY
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Formations
model Formation {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  price       Decimal   @default(0) @db.Decimal(10, 2)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  registrations FormationRegistration[]

  @@map("formations")
}

model FormationRegistration {
  id          String   @id @default(cuid())
  formationId String   @map("formation_id")
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      RegistrationStatus @default(PENDING)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([formationId, userId])
  @@map("formation_registrations")
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Messagerie
model Message {
  id          String   @id @default(cuid())
  senderId    String   @map("sender_id")
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String   @map("receiver_id")
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content     String
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
  @@map("messages")
}

// Services d'urgence
model EmergencyService {
  id          String                  @id @default(cuid())
  name        String
  type        EmergencyServiceType
  address     String?
  phone       String?
  location    String?
  hours       String  @default("24/7")
  status      ServiceStatus           @default(OPEN)
  website     String?
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  @@index([type, status])
  @@map("emergency_services")
}

enum EmergencyServiceType {
  PHARMACY
  CLINIC
  HOSPITAL
  AMBULANCE
  OTHER
}

enum ServiceStatus {
  OPEN
  CLOSED
}

// Consultations
model Consultation {
  id          String   @id @default(cuid())
  patientId   String   @map("patient_id")
  doctorId    String   @map("doctor_id")
  date        DateTime
  notes       String?
  diagnosis   String?
  prescriptions String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([patientId, date])
  @@index([doctorId, date])
  @@map("consultations")
}

// Symptômes
model Symptom {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("symptoms")
}

// Spécialités médicales
model Specialty {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("specialties")
}

// Villes et pays
model City {
  id        String   @id @default(cuid())
  country   String
  city      String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([country, city])
  @@map("cities")
}

// Annonces
model Announcement {
  id          String   @id @default(cuid())
  title       String
  description String?
  publishedAt DateTime @default(now()) @map("published_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([publishedAt])
  @@map("announcements")
}

// Notifications
model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

// Audit logs
model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("audit_logs")
}
